# ixi 4k — Configuración (NO subir a version control)
#
# Copia este fichero como .env y rellena tus valores.
# NUNCA pongas aquí contraseñas de administrador: esas viven fuera del
# repositorio (ver "Credenciales de administrador" más abajo).

# ---------------------------------------------------------------------------
# SEO / URL pública
# Se usa en canonical, Open Graph, Schema.org, robots.txt y sitemap.xml.
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://tu-dominio.com

# ---------------------------------------------------------------------------
# Autenticación cifrada JWT vía Supabase Auth.
# Sin estas variables la app corre en MODO DESARROLLO (solo builds dev)
# con rate limiting activo y sin claves estáticas en el código fuente.
#
# 1. Crea un proyecto en https://supabase.com
# 2. Copia estos valores desde Project Settings → API
# 3. Aplica las políticas RLS: supabase/security/rls_policies.sql
# 4. Asigna el rol admin: app_metadata => { "role": "admin" }
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alternativa Firebase Auth: configura firebaseConfig en services/authService.ts

# ---------------------------------------------------------------------------
# Credenciales de administrador (backend NATIVO, nunca el navegador)
#
# Opción A (recomendada): crear el fichero local de secretos
#     npm run admin:setup
#   → ~/.ixi4k/admin_credentials.json  (permisos 600, fuera del repositorio)
#
# Opción B: variables de entorno del PROCESO (no del build) — se leen al
# ejecutar la app de escritorio, por lo que nunca llegan al bundle JavaScript:
#   IXI4K_ADMIN_EMAIL=tu@email.com
#   IXI4K_ADMIN_PASSWORD_HASH=$2b$12$...   (hash bcrypt cost 12)
# ---------------------------------------------------------------------------
